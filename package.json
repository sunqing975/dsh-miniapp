{
  "name": "@sunqing975/dsh-miniapp",
  "version": "0.1.2",
  "type": "module",
  "description": "Build, run, and preview small React + Node web apps right inside DeepSeek Harness — an agent preset plus a sidebar launcher plugin in one Cordis bundle.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "package.json",
    "icon.svg",
    "locale/",
    "lib/",
    "client/",
    "skills/",
    "template/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
